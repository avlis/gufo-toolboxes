#!/usr/bin/env bash
set -euo pipefail

# deb/build-deb — build the gufo .deb from whatever the engine repository currently holds.
#
#   deb/build-deb                          # newest tag. no argument, no bump, no edit
#   deb/build-deb v<tag>                 # a specific tag
#   deb/build-deb main --snapshot         # an untagged ref, stamped <ver>+git<sha>-1
#   deb/build-deb --in-container        # build inside the builder image, memory-capped
#   deb/build-deb --dry-run             # print the plan, write nothing, run nothing
#
# There is deliberately no version anywhere in this lane's inputs. The ref defaults to the
# newest tag in the engine repository, the version comes out of the checkout's version.txt
# through gen-deb-ver, and debian/changelog is generated in the scratch tree. A new upstream
# release therefore requires no change here: the same command builds it. That is the property
# this lane has to keep -- the day a release needs a commit in the packaging repo, the
# packaging has become a thing to maintain rather than a tool that runs.
#
# Everything else is a knob with a portable default, and every knob prints itself:
#
#   CPU_FLAGS        extra codegen flags for the HOST translation units. Empty by default, so
#                    the artifact is the distro-portable one a reviewer can reproduce. Tuning a
#                    fleet is an opt-in, and it is yours to state, never ours to assume.
#   JOBS             compile parallelism. Computed, not hardcoded -- see the guard below.
#   DEBIAN_REVISION  the packager's counter, default 1.
#   DISTRO           changelog distribution. Empty -> dpkg's own guess.
#   APT_IMAGE        builder image for --in-container.
#   GUFO_REPO        where the engine comes from.
#   OUT              where the artifacts land.
#   MEM_MAX          container memory ceiling for --in-container (default 8g).

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LANE="${ROOT}/deb"
GUFO_REPO="${GUFO_REPO:-https://github.com/gufo-org/gufo.git}"
CPU_FLAGS="${CPU_FLAGS:-}"
CPP_FLAGS="${CPP_FLAGS:-}"
DEBIAN_REVISION="${DEBIAN_REVISION:-1}"
DISTRO="${DISTRO:-}"
APT_IMAGE="${APT_IMAGE:-debian:trixie}"
MEM_MAX="${MEM_MAX:-8g}"
OUT="${OUT:-${ROOT}/deb/out}"
JOBS="${JOBS:-}"
SNAPSHOT="${SNAPSHOT:-0}"
CONTAINER=0
DRY=0
REF=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --in-container) CONTAINER=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --snapshot) SNAPSHOT=1; shift ;;
    --out) OUT="$2"; shift 2 ;;
    --jobs) JOBS="$2"; shift 2 ;;
    -h|--help) sed -n '3,30p' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) REF="$1"; shift ;;
  esac
done

say() { printf '%s\n' "$*"; }
run() { if [[ "${DRY}" == "1" ]]; then printf '  dry: %s\n' "$*"; else printf '  run: %s\n' "$*"; "$@"; fi; }

# 1. The ref. Default = the newest tag in the engine repository, so a release costs nothing.
if [[ -z "${REF}" ]]; then
  printf '==> ref       : '
  REF="$(git ls-remote --tags --sort=-v:refname "${GUFO_REPO}" \
          | sed -n 's|.*refs/tags/\(v[0-9][0-9.]*\)$|\1|p' | head -1)"
  [[ -n "${REF}" ]] || { printf '\nerror: no v<tag> refs found at %s\n' "${GUFO_REPO}" >&2; exit 1; }
  printf '%s (newest tag -- nothing in this lane had to change for it)\n' "${REF}"
else
  say "==> ref       : ${REF}"
fi
say "==> ref       : ${REF}"

SCRATCH="${SCRATCH:-${ROOT}/.deb-lite-build}"
SRC="${SCRATCH}/gufo"

# 2. The checkout. Shallow, into a scratch tree: this script never writes inside a working copy
#    of the engine, and it never writes inside this repository.
run rm -rf "${SCRATCH}"
run mkdir -p "${SRC}"
run git clone --quiet --depth 1 --branch "${REF}" "${GUFO_REPO}" "${SRC}"

if [[ "${DRY}" != "1" ]]; then
  # 3. Assemble the packaging into the checkout. debian/ is not tracked by this repository at
  #    all; it is composed here, which is what keeps a release out of the packaging repo.
  run rm -rf "${SRC}/debian"
  run cp -a "${LANE}/common" "${SRC}/debian"
  run chmod +x "${SRC}/debian/rules"
  find "${SRC}/debian/tests" -maxdepth 1 -type f -exec chmod +x {} + 2>/dev/null || true

  # 4. The version, and the changelog that carries it. Generated HERE, before the build, because
  #    dpkg names .buildinfo and .changes from the version parsed at build START: regenerating
  #    later leaves an artifact whose sidecars name a different tree, which is worse than no
  #    provenance.
  version="$(DEBIAN_REVISION="${DEBIAN_REVISION}" SNAPSHOT="${SNAPSHOT}" "${LANE}/gen-deb-ver" "${SRC}" "${DEBIAN_REVISION}")"
  say "==> version   : ${version} (from ${SRC}/version.txt + the tag at $(git -C "${SRC}" rev-parse --short HEAD))"
  run env DEBIAN_REVISION="${DEBIAN_REVISION}" "${SRC}/debian/gen-changelog.sh" "$(cat "${SRC}/version.txt")"
else
  run rm -rf "${SRC}/debian"
  run cp -a "${LANE}/common" "${SRC}/debian"
  printf '  dry: gen-deb-ver %s %s -> <version from that checkout version.txt + tag>\n' "${SRC}" "${DEBIAN_REVISION}"
  printf '  dry: %s/debian/gen-changelog.sh <version.txt>   # generated in the scratch tree, never here\n' "${SRC}"
fi

# 5. Parallelism. A guard, not a comment.
#
#    This project's heaviest translation units are HIP kernels compiled at -O3 by AMD clang, and
#    they want gigabytes each. dh_auto_build --parallel falls back to nproc when the caller says
#    nothing, and on a host that is holding model weights in unified memory that is how a build
#    becomes an out-of-memory event which lands on whatever else is running -- not on the build.
#    So the cap is computed from what the machine reports right now, and the inputs are printed
#    so a reviewer can disagree with the arithmetic rather than with the number.
avail_kib="$(awk '/MemAvailable/{print $2}' /proc/meminfo)"
avail_gib=$(( avail_kib / 1024 / 1024 ))
# PER_JOB_GiB is an estimate, not a measurement: 3 GiB per concurrent clang job covers the HIP
# kernel units that dominate this build. RESERVE_GiB is not an estimate -- it is the room the
# rest of the machine needs to stay alive, and taking the last of it is exactly what turns a
# compile into somebody else's restart.
per_job="${PER_JOB_GiB:-3}"
reserve="${RESERVE_GiB:-2}"
nproc="$(nproc)"
usable=$(( avail_gib - reserve ))
[[ "${usable}" -lt 0 ]] && usable=0
jobs_by_mem=$(( usable / per_job ))
cap=16
[[ "${nproc}" -lt "${cap}" ]] && cap="${nproc}"
jobs="${JOBS:-${cap}}"
[[ "${jobs_by_mem}" -lt "${jobs}" ]] && jobs="${jobs_by_mem}"

say "==> parallelism: nproc=${nproc} MemAvailable=${avail_gib}GiB reserve=${reserve}GiB per-job=${per_job}GiB -> -j${jobs}${JOBS:+ (JOBS honoured within the memory cap)}"
if [[ "${jobs}" -lt 1 ]]; then
  cat >&2 <<EOF
error: MemAvailable is ${avail_gib}GiB; at ${per_job}GiB per job there is no safe -j.
       This host is holding something large in memory -- a resident model, most likely.
       Either build in the container (--in-container, which caps the build's own memory so an
       out-of-memory event stays inside the container), or take the window when the machine is
       yours. Building here anyway is how a served endpoint gets killed by a compile.
EOF
  exit 1
fi

DISTRO_ARG=()
[[ -n "${DISTRO}" ]] && DISTRO_ARG=(-d "${DISTRO}")

build_opts="noautodbgsym parallel=${jobs}"
env_lines=(
  "DEB_BUILD_OPTIONS=${build_opts}"
  "DEB_CFLAGS_APPEND=${CPU_FLAGS}"
  "DEB_CXXFLAGS_APPEND=${CPU_FLAGS}"
  "DEB_CPPFLAGS_APPEND=${CPP_FLAGS}"
)
say "==> codegen   : ${CPU_FLAGS:-<portable baseline, no -march>}"
say "==> build opts: ${build_opts}"

if [[ "${CONTAINER}" == "1" ]]; then
  # --memory means the kernel's out-of-memory decision is taken inside this container's cgroup.
  # The host's other processes -- including anything serving -- are not candidates. That is the
  # structural reason to build in a container on a machine that also serves.
  say "==> container : ${APT_IMAGE}, --memory ${MEM_MAX} (an OOM stays inside the container)"
  run podman run --rm --memory "${MEM_MAX}" --memory-swap 0 \
    -v "${SCRATCH}:${SCRATCH}" -w "${SCRATCH}/gufo" \
    -e HOME=/tmp "${env_lines[@]}" \
    "${APT_IMAGE}" \
    sh -c 'apt-get update -qq && apt-get install -y -qq --no-install-recommends debhelper cmake ninja-build pkg-config python3 rocm-llvm libicu-dev libcurl4-openssl-dev libssl-dev libpng-dev libjpeg-dev libwebp-dev >/dev/null && dpkg-buildpackage -b -us -uc'
  OUT_SRC="${SCRATCH}"
else
  say "==> host build: native toolchain, no memory ceiling -- this is the arm that can starve a host"
  run env "${env_lines[@]}" dpkg-buildpackage -b -us -uc "${DISTRO_ARG[@]}"
  OUT_SRC="$(pwd)"
fi

# 6. Collect. Whole groups only: a .deb without its .buildinfo and .changes has no provenance.
run mkdir -p "${OUT}"
shopt -s nullglob
moved=0
for f in "${OUT_SRC}"/gufo_*.{deb,buildinfo,changes} "${OUT_SRC}"/gufo-rocm-repo_*.{deb,buildinfo,changes}; do
  run mv -f "${f}" "${OUT}/" 2>/dev/null || true
  moved=$((moved+1))
done
shopt -u nullglob
[[ "${moved}" -gt 0 ]] || say "note: no artifacts matched (dry run, or the build produced nothing)"
say "==> artifacts : ${OUT}"
ls -la "${OUT}" 2>/dev/null | tail -8 || true
