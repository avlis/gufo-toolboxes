#!/usr/bin/make -f

export DH_VERBOSE = 1

# Hardening on, as Debian expects. No architecture tuning here on purpose: the flags a fleet may
# want are a packager's opt-in through CPU_FLAGS in deb/build-deb, never a default baked into the
# recipe. The default build must run on the distro-archived toolchain of any supported host, and a
# portable binary is the artifact a reviewer can reproduce.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# Where ROCm lives. Discovered through ROCm's own tool so a machine that installed it elsewhere
# builds unchanged; DEB_ROCM_PREFIX overrides for anything unusual. Nothing here hard-assumes
# /opt/rocm: that is only the fallback when discovery finds nothing, and a wrong value fails
# loudly at find_package(hip) instead of being silently correct on one maintainer's machine.
#
# Three makefile traps, all of which an earlier version of this fell into: `$2' must be written
# `$$2' or make expands it before awk sees it; a `:=' on ROCM_PREFIX makes its origin "file",
# which then defeats the origin test that follows it; and the fallback must not clobber a value
# the user supplied on the command line or in the environment. So the branch tests the origin of
# the OVERRIDE, not of the variable being assigned.
ifeq ($(origin DEB_ROCM_PREFIX),undefined)
ROCM_PREFIX := $(shell hipconfig 2>/dev/null | awk -F: '/^HIP_PATH/{gsub(/[ \t]/,"",$$2); print $$2}')
ifeq ($(strip $(ROCM_PREFIX)),)
ROCM_PREFIX := /opt/rocm
endif
else
ROCM_PREFIX := $(DEB_ROCM_PREFIX)
endif

override_dh_auto_configure:
	dh_auto_configure -- \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_PREFIX_PATH="$(ROCM_PREFIX)" \
		-DGUFO_RELEASE_VERSION=$(shell cat version.txt) \
		-DGUFO_REVISION=$(shell debian/get-revision.sh)

# --parallel is capped by the caller through DEB_BUILD_OPTIONS=parallel=N. Left uncapped,
# dh_auto_build falls back to nproc, and this project's heaviest translation units are HIP
# kernels at -O3 that each want gigabytes: on a host that is holding model weights in unified
# memory, an uncapped build is an out-of-memory event that lands on whatever else is running.
# deb/build-deb computes the cap and prints it; a human invoking dpkg-buildpackage directly is
# responsible for the same choice.
override_dh_auto_build:
	dh_auto_build --parallel

override_dh_auto_install:
	dh_auto_install --destdir=debian/gufo

# The package build does NOT run this project's test suite, and that is stated here on purpose:
# an empty override reads as "nobody thought about it", which is how unverified binaries ship
# quietly. Skipped: the C++ host tests and every GPU functional check -- they need ROCm devices,
# model weights and a device budget a package build does not have. What does run: the smoke test
# in debian/tests/, locally through deb/tests/lite-scope.sh and in CI as the autopkgtest
# declared by Testsuite: autopkgtest in debian/control.
override_dh_auto_test:

# debian/changelog is generated, not maintained, and this lane owns generating it: the release
# automation picks the tag, debian/gen-changelog.sh derives the version from the engine's
# version.txt and writes the minimal entry a Debian changelog has to have -- the version, and a
# pointer to the release. It copies no prose from Gufo's CHANGELOG.md: that file and the release
# page are the history, and a second copy here is the copy that goes stale. version.txt stays
# canonical and Gufo's release automation is untouched.
#
# A build never writes to a tree it was not given. deb/build-deb assembles this directory into a
# scratch checkout and generates the entry THERE, before the build starts, because dpkg names
# its .buildinfo and .changes from the version parsed at build START -- regenerating mid-build
# yields a 0.24.0 .deb beside a 0.21.0 .buildinfo, provenance that names the wrong tree, which
# is worse than none.
#
# So here: generate if the entry is absent (a fresh checkout, the normal case), verify if it is
# present, and fail with both versions when they drift.
execute_before_dh_gencontrol:
	@if [ ! -f debian/changelog ]; then \
		echo "debian/rules: no debian/changelog; generating it from version.txt."; \
		debian/gen-changelog.sh; \
	else \
		changelog_version=$$(dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//'); \
		version=$$(cat version.txt); \
		if [ "$$changelog_version" != "$$version" ]; then \
			echo "debian/rules: debian/changelog is at $$changelog_version but version.txt is at $$version." >&2; \
			echo "debian/rules: re-run debian/gen-changelog.sh, or build through deb/build-deb, which does that for you." >&2; \
			exit 1; \
		fi; \
	fi

# dwz cannot process the DWARF5 debug sections emitted by the ROCm clang toolchain; skip the
# debug-info deduplication step.
override_dh_dwz:

# The AMD ROCm packages ship no shlibs metadata, so dpkg-shlibdeps cannot resolve the ROCm
# sonames the binary links. They are declared explicitly in debian/control instead; this flag
# suppresses only that known gap, it does not silence the whole pass.
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
